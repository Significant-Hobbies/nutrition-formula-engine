{
  "name": "nutrition-formula-engine",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["python_workers"],
  "find_additional_modules": true,
  "base_dir": "./src",
  "routes": [
    {
      "pattern": "formula.significanthobbies.com",
      "custom_domain": true
    }
  ],
  "rules": [
    {
      "type": "Data",
      "globs": ["nutrition_formula/data/*.json"],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
